# Modelo sem segredos — copia para apps/web/.env.local (recomendado) ou .env na raiz.
# Nunca coloques valores reais neste ficheiro versionado.

# Auth.js — gera AUTH_SECRET com: yarn auth:secret
AUTH_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (ex.: Supabase → Settings → Database → URI)
DATABASE_URL=

# Opcional — Supabase Storage (CV / exports)
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
