# Hunter — variáveis centralizadas (copie para .env na raiz)
# Nunca versionar segredos reais.

# ============================================
# Banco e autenticação
# ============================================
DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ============================================
# Storage
# ============================================
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""
CV_STORAGE_BUCKET="cvs"

# ============================================
# Worker/MCP
# ============================================
HUNT_EXECUTOR="mcp"
WORKER_POLL_INTERVAL_MS="3000"
WORKER_MAX_BACKOFF_MINUTES="60"
MCP_REQUEST_TIMEOUT_MS="120000"
MCP_INITIALIZE_TIMEOUT_MS="20000"
MCP_TOOL_RETRIES="2"
MCP_TOOL_RETRY_DELAY_MS="1200"
MCP_SCORE_TOOL_RETRIES="1"
MCP_SCORE_REQUEST_TIMEOUT_MS="15000"
MCP_SCORE_CIRCUIT_BREAKER_TIMEOUTS="3"
MCP_PROVIDER_TIMEOUT_MS="25000"
HUNT_MAX_OPENINGS_FROM_SEARCH="120"
HUNT_MAX_OPENINGS_TO_SCORE="40"
HUNT_SCORE_CONCURRENCY="3"
HUNT_SCORE_PROGRESS_EVERY="5"
HUNT_PERSIST_CONCURRENCY="4"
HUNT_SCORE_TIMEOUT_CONTINUE="1"
HUNT_AUTO_APPLY_ENABLED="1"
HUNT_AUTO_APPLY_DRY_RUN="0"
HUNT_AUTO_APPLY_THRESHOLD="85"
HUNT_AUTO_APPLY_MAX_SUBMISSIONS="20"
HUNT_ATS_TAILOR_RESUME_ENABLED="1"
HUNT_ATS_TAILOR_RESUME_MAX_CHARS="6000"
HUNT_AUTO_APPLY_ALLOWED_SOURCES="nerdin,github"
AUTO_APPLY_ACCESS_TOKEN=""
HUNT_MAX_DURATION_MS="900000"
NOTIFY_INTERESTING_MATCH_SCORE="80"
GITHUB_TOKEN=""
GREENHOUSE_BOARD_TOKENS=""
LEVER_SITES=""
LINKEDIN_PAGES="2"
NERDIN_PAGES="1"
LINKEDIN_SEARCH_URL=""

# ============================================
# LLM
# ============================================
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# ============================================
# Notificações externas (sem Discord)
# ============================================
NOTIFY_WEBHOOK_URL=""
NOTIFY_WEBHOOK_TOKEN=""
NOTIFY_WEBHOOK_EVENTS="hunt_completed,hunt_failed,hunt_warning"

# Email de resumo/relatório via Resend
NOTIFY_RESEND_API_KEY=""
NOTIFY_EMAIL_FROM=""
NOTIFY_EMAIL_TO=""

# ============================================
# Docker local
# ============================================
WEB_PORT="5000"
