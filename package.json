{
  "name": "hunter",
  "version": "1.0.0",
  "private": true,
  "description": "Hunter — caça de vagas (CLI + plataforma web)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace web dev",
    "build": "yarn workspace web build",
    "lint": "yarn workspace web lint",
    "mcp:server": "yarn workspace web mcp:server",
    "worker": "yarn workspace web worker",
    "worker:once": "yarn workspace web worker:once",
    "auth:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "db:generate": "yarn workspace @hunter/db generate",
    "db:push": "yarn workspace @hunter/db push",
    "db:studio": "yarn workspace @hunter/db studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrohlucena/hunter.git"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1",
    "gh": "^2.8.9"
  }
}
